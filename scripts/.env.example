# URL de la API compatible que controlas. No uses credenciales de terceros.
MESSAGING_API_BASE_URL=https://tu-api.example
MESSAGING_API_TOKEN=pon-el-secreto-en-el-gestor-de-secretos

# Grindr Discover usa exactamente GET /v4/discover?geohash=<geohash_de_12_caracteres>.
# En modo geohash no se envían city, country, latitude ni longitude.
# Cambia la ruta solo si tu API compatible expone otra ruta con el mismo contrato.
USER_SEARCH_PATH=/v4/discover
SEND_MESSAGE_PATH=/messages
SEARCH_LOCATION_MODE=geohash

# Secuencia automática: Terrassa -> España -> países LATAM.
TERRASSA_CITY=Terrassa
SPAIN_COUNTRY=ES
LATAM_COUNTRIES=MX,AR,CO,CL,PE,BR,UY,PY,BO,EC,VE,CR,PA,GT,SV,HN,NI,DO,CU,HT
# Coordenadas de Terrassa. En modo geohash son necesarias si no configuras GEOCODING_URL.
TERRASSA_LATITUDE=41.563
TERRASSA_LONGITUDE=2.008
# Radio opcional para compatibilidad de configuración; Grindr Discover usa el geohash.
# TERRASSA_RADIUS_KM=
# El script usa automáticamente un punto central aproximado para cada país
# configurado en LATAM_COUNTRIES. No necesitas introducir coordenadas por país.
# Estas coordenadas son opcionales y permiten sobrescribir un punto concreto.
# LOCATION_COORDINATES=ES:41.390,2.170;MX:19.433,-99.133;AR:-34.604,-58.382

# Servicio compatible con una respuesta tipo Nominatim:
# [{"lat":"41.563","lon":"2.008"}]. Déjalo vacío para usar las coordenadas anteriores.
# GEOCODING_URL=https://nominatim.openstreetmap.org/search
# GEOCODING_USER_AGENT=consent-notification-broadcaster/1.0

# Mensajes y controles de la campaña.
# En Replit, configúralos como Secrets/Environment Variables.
MESSAGE_ONE=MENSAJE_1_CONFIGURABLE
MESSAGE_TWO=MENSAJE_2_CONFIGURABLE
PAUSE_MS=2000
MAX_RECIPIENTS_PER_LOCATION=25
LOCATION_PAUSE_MS=10000
# Espera entre ciclos completos. 3600000 = 1 hora.
CYCLE_PAUSE_MS=3600000
REQUEST_TIMEOUT_MS=15000

# Debe permanecer true hasta validar el flujo en tu entorno.
DRY_RUN=true
STATE_FILE=.data/notification-state.json
AUDIT_FILE=.data/notification-audit.jsonl