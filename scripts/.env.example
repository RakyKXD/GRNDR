# URL de la API que controlas. No uses credenciales de terceros.
MESSAGING_API_BASE_URL=https://tu-api.example
MESSAGING_API_TOKEN=pon-el-secreto-en-el-gestor-de-secretos

# Adapta estas rutas a tu contrato.
USER_SEARCH_PATH=/users/search
SEND_MESSAGE_PATH=/messages

# Secuencia automática: Terrassa -> España -> países LATAM.
TERRASSA_CITY=Terrassa
SPAIN_COUNTRY=ES
LATAM_COUNTRIES=MX,AR,CO,CL,PE,BR,UY,PY,BO,EC,VE,CR,PA,GT,SV,HN,NI,DO,CU,HT
# Coordenadas y radio opcionales para la búsqueda inicial de Terrassa.
# TERRASSA_LATITUDE=
# TERRASSA_LONGITUDE=
# TERRASSA_RADIUS_KM=

# Mensajes y controles de la campaña.
# En Replit, configúralos como Secrets/Environment Variables.
MESSAGE_ONE=MENSAJE_1_CONFIGURABLE
MESSAGE_TWO=MENSAJE_2_CONFIGURABLE
PAUSE_MS=2000
MAX_RECIPIENTS_PER_LOCATION=25
LOCATION_PAUSE_MS=10000
# Espera entre ciclos completos. 3600000 = 1 hora.
CYCLE_PAUSE_MS=3600000
REQUEST_TIMEOUT_MS=15000

# Debe permanecer true hasta validar el flujo en tu entorno.
DRY_RUN=true
STATE_FILE=.data/notification-state.json
AUDIT_FILE=.data/notification-audit.jsonl